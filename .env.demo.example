# Hallway public live demo: invite-only, behind a Cloudflare Tunnel.
# Don't copy this by hand: `scripts/up.sh --demo` copies it to .env, replaces
# every __RANDOM__ with a fresh random value (three distinct keys and the invite
# code), fills in the Switch section, and prints the invite link. See docs/DEPLOY.md.
# Hallway refuses to start while any key is still __RANDOM__, empty or change-me,
# or two keys are the same. No inline comments: keep each comment on its own line.

# ---------------------------------------------------------------- the public site
# The tunnel's public hostname. up.sh --demo --host <name> sets it.
HALLWAY_PUBLIC_URL=https://hallway.debopamchowdhury.com
# production: no /docs, /redoc or /openapi.json, strict start-up checks.
HALLWAY_ENV=production
EVENT_NAME=Bharat Builds Bengaluru

# ---------------------------------------------------------------- who gets in
# demo: no email provider. The sign-in link is shown on screen, but only for an
# email with no account yet (an email that already joined gets no link).
SIGNIN_MODE=demo
EMAIL_SENDER=console
# New emails can only start sign-in from https://<host>/?invite=<INVITE_CODE>.
INVITE_CODE=__RANDOM__
# At most 10 people join through the invite link. Seeded personas don't count.
INVITE_LIMIT=10
# Linked from the "This demo is full" screen (e.g. a YouTube walkthrough).
DEMO_VIDEO_URL=
# Hard cap on accounts, personas included (sizes Mattermost's team as well).
MAX_ATTENDEES=50

# ---------------------------------------------------------------- secrets
# Three separate keys, each `openssl rand -hex 24`, generated by up.sh --demo.
# Switch -> /guardrails/check
GUARD_API_KEY=__RANDOM__
# The organiser's key (x-hallway-admin): admin API and persona seeding. Never share it.
HALLWAY_ADMIN_KEY=__RANDOM__
# The day pass worker's key (/internal/daypass/*)
DAYPASS_WORKER_KEY=__RANDOM__

# ---------------------------------------------------------------- Cloudflare Tunnel
# From Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> the
# `--token` value of the docker command. Starts the `cloudflared` service.
TUNNEL_TOKEN=

# ---------------------------------------------------------------- day pass (optional)
# up.sh --demo turns DAYPASS_ENABLED to true when one of the model keys below is
# set, false otherwise (then the worker isn't started and nobody is offered a pass).
DAYPASS_ENABLED=false
DAYPASS_PRICE=₹149
# USD each day pass may spend. Worst case for the whole demo: INVITE_LIMIT x cap
# = 10 x $0.25 = $2.50 (personas don't take day passes). Each worker run is capped
# at DAYPASS_PER_RUN_USD as well.
DAYPASS_CAP_USD=0.25
DAYPASS_PER_RUN_USD=0.05
DAYPASS_EVERY_S=600
DAYPASS_MODEL=vercel:deepseek/deepseek-v4.1-flash-1017
VERCEL_AI_GATEWAY_API_KEY=
DAYPASS_PRICE_PER_MTOK=0.30,1.20
# Or Claude: DAYPASS_MODEL=claude-haiku-5-5, ANTHROPIC_API_KEY=..., and no DAYPASS_PRICE_PER_MTOK
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- behind Cloudflare
# The visitor's IP is CF-Connecting-IP. Only safe because nothing but the tunnel
# reaches Hallway (its port is bound to 127.0.0.1).
TRUST_CF_CONNECTING_IP=true
# Rate limits (in memory), <count>/<seconds>. The defaults, written out:
RATE_LIMITS=on
RATE_LIMIT_AUTH_START_IP=20/60
RATE_LIMIT_AUTH_START_EMAIL=5/900
RATE_LIMIT_MAGIC_IP=30/60
RATE_LIMIT_REGISTER_IP=10/60
RATE_LIMIT_SESSION_WRITE=60/60
RATE_LIMIT_MCP_CALL=120/60
RATE_LIMIT_MCP_OUTREACH=6/60
RATE_LIMIT_GUARD=1200/60

# ---------------------------------------------------------------- Switch (up.sh fills these)
SWITCH_URL=http://localhost:8000
SWITCH_REGISTRATION_KEY=
GATEWAY_ADMIN_EMAIL=
GATEWAY_ADMIN_PASSWORD=
MM_URL=http://localhost:8065
MM_ADMIN_USER=admin
MM_ADMIN_PASSWORD=
MM_TEAM=switch
HALLWAY_GUARD_ENDPOINT=http://hallway:8787
LOBBY_ROOM_NAME=hallway-lobby
