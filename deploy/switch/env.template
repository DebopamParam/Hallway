# Switch standalone stack for Hallway (filled in by scripts/up.sh).
# Secrets marked __RANDOM__ are generated on first run.
COMPOSE_PROJECT_NAME=switch
COMPOSE_PROFILES=collab,gateway
SWITCH_VERSION=0.31.0
SWITCH_BIND_ADDR=127.0.0.1
DB_USER=switch_app
DB_PASSWORD=__RANDOM__
DB_OWNER_USER=postgres
DB_OWNER_PASSWORD=__RANDOM__
DB_NAME=switch
# Never change after first start
ID_SERVER_NAME=localhost
AGENT_REGISTRATION_TOKEN=__RANDOM__
CONTROLLER_TOKEN_SECRET=__RANDOM__
SECRET_KEYS=__SECRET_KEYS__
FEATURE_FLAGS_ENABLED=agent_management,service_connections
GATEWAY_ADMIN_EMAIL=admin@switch.local
GATEWAY_ADMIN_PASSWORD=__RANDOM__
GATEWAY_PUBLIC_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
MATTERMOST_ADMIN_USER=admin
MATTERMOST_ADMIN_PASSWORD=__RANDOM__
MATTERMOST_TEAM_NAME=switch
MATTERMOST_USER=user
MATTERMOST_USER_PASSWORD=__RANDOM__
OUTBOUND_ALLOWED_PRIVATE_HOSTS=localhost
TELEMETRY_ENABLED=false
