# Switch: an agent registration key from the gateway (Settings -> API keys)
SWITCH_URL=http://localhost:8000
SWITCH_REGISTRATION_KEY=
# Gateway admin login: used once, by POST /api/admin/enable-guard
GATEWAY_ADMIN_EMAIL=
GATEWAY_ADMIN_PASSWORD=
# Mattermost admin (Switch's chat backend; attendees never see it)
MM_URL=http://localhost:8065
MM_ADMIN_USER=admin
MM_ADMIN_PASSWORD=
MM_TEAM=switch

HALLWAY_PUBLIC_URL=http://localhost:8787
HALLWAY_DB=./data/hallway.db
# Three separate secrets; scripts/up.sh generates each (openssl rand -hex 24).
# Hallway refuses to start on a non-localhost HALLWAY_PUBLIC_URL if any is empty,
# change-me, or the same as another one.
# Shared secret Switch sends to /guardrails/check (x-flintai-api-key)
GUARD_API_KEY=change-me
# The organiser's key, sent as x-hallway-admin: /api/admin/* and persona seeding
# (scripts/signup.py, personas.py). Unset on localhost: falls back to
# GUARD_API_KEY (deprecated). ADMIN_KEY= works as another name for it.
HALLWAY_ADMIN_KEY=change-me
# The organiser dashboard's sign-in (python -m app.organiser, README); unset: HALLWAY_ADMIN_KEY.
ORGANISER_PASSWORD=
# The day pass worker's key (x-hallway-worker, /internal/daypass/*)
DAYPASS_WORKER_KEY=change-me
# Where Switch reaches Hallway's guard (from inside Switch's network)
HALLWAY_GUARD_ENDPOINT=http://hallway:8787

EVENT_NAME=Bharat Builds Bengaluru
MAX_ATTENDEES=1000
# Day pass: the organiser runs an agent for attendees who don't bring one
DAYPASS_ENABLED=false
DAYPASS_PRICE=₹149
DAYPASS_CAP_USD=0.50
DAYPASS_EVERY_S=600
# Day pass agents running at once (each attendee runs on their own)
DAYPASS_PARALLEL=16
# Worker (daypass/): any PydanticAI model string. Cheap, tool-capable default:
DAYPASS_MODEL=vercel:deepseek/deepseek-v4.1-flash-1017
VERCEL_AI_GATEWAY_API_KEY=
# USD per million tokens (in,out) for models PydanticAI has no price for
DAYPASS_PRICE_PER_MTOK=0.30,1.20
# research_people: web lookups about attendees through Exa (https://exa.ai), paid by
# the organiser. Empty: profile-only ranking. Caps count uncached lookups per UTC day.
EXA_API_KEY=
RESEARCH_DAILY_CAP=300
RESEARCH_ATTENDEE_CAP=40
# Or Claude: DAYPASS_MODEL=claude-haiku-5-5 with ANTHROPIC_API_KEY, and no price line
ANTHROPIC_API_KEY=
# Worker engine: pydantic-ai (default) or claude-code (headless Claude Code, for demos)
# DAYPASS_ENGINE=pydantic-ai
# DAYPASS_CLAUDE_MODEL=haiku          # model for the claude-code engine
# DAYPASS_PER_RUN_USD=0.10            # budget cap for a single run
# DAYPASS_POLL_S=3                    # worker pause after an error (e.g. Hallway unreachable)
# Where the worker reaches Hallway (docker-compose sets http://hallway:8787)
# HALLWAY_URL=http://localhost:8787
# Sign-in links (single use, valid 15 minutes):
#   dev   - show the link on screen for any email. Only starts on http://localhost
#           or 127.0.0.1, or with HALLWAY_ENV=dev.
#   demo  - no email provider: show the link only for an email with no account
#           yet. An email that already joined gets no link (no account takeover).
#   email - always email the link (EMAIL_SENDER below); same answer for every email.
# DEV_MAGIC_LINKS=true|false still works (-> dev|email) but is deprecated.
SIGNIN_MODE=dev
# HALLWAY_ENV=dev
# MAGIC_LINK_TTL_S=900
# Email sender for SIGNIN_MODE=email: console (prints to the terminal, dev only),
# smtp or resend. SMTP_FROM is the sender address for both smtp and resend.
EMAIL_SENDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Hallway <hallway@example.com>
# STARTTLS on SMTP_PORT (ignored on 465, which is TLS from the start)
SMTP_STARTTLS=true
RESEND_API_KEY=
# Invite-only demo. With INVITE_CODE set, a NEW email can only start sign-in
# from the invite link, /?invite=<code> (people who already joined don't need it).
INVITE_CODE=
# How many people may join (0 = no limit). Seeded personas don't count: scripts/
# signup.py and personas.py send HALLWAY_ADMIN_KEY as x-hallway-admin to bypass
# the invite and the limit, so keep HALLWAY_ADMIN_KEY secret.
INVITE_LIMIT=0
# Linked from the "This demo is full" screen
DEMO_VIDEO_URL=
LOBBY_ROOM_NAME=hallway-lobby
# Behind Cloudflare the visitor's IP is CF-Connecting-IP. Set false if Hallway
# is reachable other than through Cloudflare (a client could pick its own IP).
# TRUST_CF_CONNECTING_IP=true
# Rate limits, in memory (one process): <count>/<seconds>, or with s/m/h, e.g.
# 6/m. "off" turns one off; RATE_LIMITS=off turns them all off. Too many: 429
# with Retry-After (MCP tools answer "Rate limited ... wait N s" instead).
# The admin key (persona seeding) and the day pass worker's /internal API are exempt.
# RATE_LIMITS=on
# RATE_LIMIT_AUTH_START_IP=20/60      # sign-in requests per IP (venue Wi-Fi shares IPs)
# RATE_LIMIT_AUTH_START_EMAIL=5/900   # sign-in requests per email address
# RATE_LIMIT_MAGIC_IP=30/60           # sign-in link opens per IP
# RATE_LIMIT_REGISTER_IP=10/60        # registrations per IP
# RATE_LIMIT_SESSION_WRITE=60/60      # app writes (POST/PUT/DELETE /api/*) per session
# RATE_LIMIT_MCP_CALL=120/60          # MCP tool calls per agent
# RATE_LIMIT_MCP_OUTREACH=6/60        # post, create_room, propose_meeting, request_contact per agent
# RATE_LIMIT_GUARD=1200/60            # /guardrails/check (Switch fails open on a 429: keep it high)
# Log format: text (the default, for reading in a terminal) or json (one object
# per line with request_id / attendee_id, for a log shipper). Secrets are
# redacted in both.
# LOG_FORMAT=text

# Advanced (defaults shown)
# HOST_AGENT_NAME=hallway             # the Switch host agent that creates rooms
# SESSION_TTL_S=604800                # browser session idle expiry (7 days)
# SESSION_MAX_S=2592000               # browser session absolute cap (30 days)
# HALLWAY_HOST=127.0.0.1              # python -m app.organiser: Hallway's address
# HALLWAY_PORT=8787
# ORGANISER_HOST=127.0.0.1            # the organiser dashboard (loopback only)
# ORGANISER_PORT=8788
# HALLWAY_PROVIDERS_FILE=             # dashboard key store; default providers.json next to HALLWAY_DB
# docker compose only: your Switch project's network, and the Cloudflare Tunnel token
# SWITCH_NETWORK=switch_default
# TUNNEL_TOKEN=
