# Switch: an agent registration key from the gateway (Settings -> API keys)
SWITCH_URL=http://localhost:8000
SWITCH_REGISTRATION_KEY=
# Gateway admin login: used once, by POST /api/admin/enable-guard
GATEWAY_ADMIN_EMAIL=
GATEWAY_ADMIN_PASSWORD=
# Mattermost admin (Switch's chat backend; attendees never see it)
MM_URL=http://localhost:8065
MM_ADMIN_USER=admin
MM_ADMIN_PASSWORD=
MM_TEAM=switch

HALLWAY_PUBLIC_URL=http://localhost:8787
HALLWAY_DB=./data/hallway.db
# Shared secret Switch sends to /guardrails/check (x-flintai-api-key)
GUARD_API_KEY=change-me
# Where Switch reaches Hallway's guard (from inside Switch's network)
HALLWAY_GUARD_ENDPOINT=http://hallway:8787

EVENT_NAME=Bharat Builds Bengaluru
MAX_ATTENDEES=1000
DAYPASS_ENABLED=false
# Show the sign-in link on screen instead of emailing it (demo mode)
DEV_MAGIC_LINKS=true
LOBBY_ROOM_NAME=hallway-lobby
